<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sujud.PrayerTimesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Page.Resources>
        <!-- Sizes measured from the Clock app's World Clock page, as on iOS. -->
        <Style x:Key="ClockText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ClockFontFamily}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="TextLineBounds" Value="TrimToBaseline" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource ClockText}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="NameText" TargetType="TextBlock" BasedOn="{StaticResource ClockText}">
            <Setter Property="FontSize" Value="28" />
        </Style>
        <Style x:Key="TimeText" TargetType="TextBlock" BasedOn="{StaticResource ClockText}">
            <Setter Property="FontSize" Value="60" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>
        <Style x:Key="DayPeriodText" TargetType="TextBlock" BasedOn="{StaticResource ClockText}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel MaxWidth="640" Padding="20,12,20,24">
                <TextBlock
                    x:Name="Heading"
                    Style="{StaticResource ClockText}"
                    FontSize="34"
                    FontWeight="Bold"
                    TextLineBounds="Full"
                    Margin="0,0,0,8" />
                <StackPanel x:Name="Rows" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

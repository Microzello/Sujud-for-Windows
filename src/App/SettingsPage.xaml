<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sujud.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel MaxWidth="640" Padding="20,12,20,24" Spacing="24">
                <ComboBox x:Name="MethodBox" HorizontalAlignment="Stretch" SelectionChanged="OnMethodChanged" />
                <RadioButtons x:Name="AsrButtons" SelectionChanged="OnAsrChanged" />
                <TextBlock
                    x:Name="Credits"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="Prayer times follow PrayTimes.org by Hamid Zarrabi-Zadeh." />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
